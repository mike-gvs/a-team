# Copy to .env. Empty values are enough for a local stub run.
# Variables marked "# credential" are listed in README › Prerequisites.

# --- deploy ---
ENVIRONMENT=development
HOST_BIND=127.0.0.1
# Bound port on the host (nginx). Only this port is published.
ATEAM_PORT=8080

# Session signing. Empty is allowed in development (a local key is generated).
# Required and must not be a placeholder when ENVIRONMENT=production.
ATEAM_SECRET_KEY=

# --- database ---
POSTGRES_USER=ateam
POSTGRES_DB=ateam
POSTGRES_PASSWORD=   # credential — local Postgres password; generated for development if empty

# --- release metadata (set by Makefile / image build) ---
VERSION=0.1.0
IMAGE_TAG=0.1.0-dev

# --- model provider secrets (used only if you pick that provider in the wizard) ---
ANTHROPIC_API_KEY=   # credential — Anthropic, optional; https://console.anthropic.com/settings/keys — usage-based, off unless you select Anthropic

# --- connector secrets (used only if you switch that connector to live in the wizard) ---
POSTMARK_API_TOKEN=   # credential — Postmark email, optional; https://postmarkapp.com/ — usage-based, stub by default
TWILIO_ACCOUNT_SID=   # credential — Twilio SMS, optional; https://www.twilio.com/console — usage-based, stub by default
TWILIO_AUTH_TOKEN=    # credential — Twilio SMS auth token, optional; same console as above
TWILIO_FROM_NUMBER=   # credential — Twilio from-number, optional; E.164, only if SMS is live
